{
  "expo": {
    "name": "Build Tower",
    "slug": "build-tower",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/ios-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "backgroundColor": "#ffffff",
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.sanin.buildtower",
      "appStoreUrl": "https://apps.apple.com/app/id6806200749",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sanin.buildtower",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.sanin.buildtower"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 180,
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#017BA5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e431bab4-8581-4870-943d-1f242180760d"
      }
    },
    "owner": "san-in"
  }
}
